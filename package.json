{
  "scripts": {
    "build": "npm run export:content && hugo --minify --destination .superpowers/build/site && npm --prefix admin run build -- --outDir ../.superpowers/build/admin",
    "export:content": "node scripts/export-firestore-content.mjs",
    "build:site": "hugo --minify",
    "test:release-manifest": "node --test scripts/release-manifest.test.mjs",
    "test:publisher-state": "node --test scripts/publisher-state.test.mjs",
    "set:owner-claim": "node scripts/assign-owner-claim.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "hugo-extended": "^0.166.0"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0"
  }
}
